<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- SPDX-License-Identifier: MIT OR Apache-2.0 -->
<!--
  Elevation by default (roadmap decision): WFP enforcement and the per-connection counters need
  an administrator. The OS shows a UAC prompt at launch. If the user cannot elevate, the app
  still starts in monitor-only mode and shows why enforcement is unavailable.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v1">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
